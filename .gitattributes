# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sql text eol=lf

# All assets under agents/**/assets are byte-exact because model_card.json hashes them
agents/agent_2_analytical_scientist/assets/** -text

# Binary files - preserve exact bytes
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.npz binary
*.pt binary
*.zip binary
*.db binary
